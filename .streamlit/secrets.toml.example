# ==============================================================================
# STREAMLIT SECRETS CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS FOR CLOUD DEPLOYMENT:
# In Streamlit Community Cloud:
# 1. Navigate to your app dashboard -> Settings -> Secrets.
# 2. Paste the key below and replace CHANGE_ME_COACH_PASSWORD with your secure password.
# 3. Save the secrets.
#
# INSTRUCTIONS FOR LOCAL TESTING:
# 1. Copy this file to .streamlit/secrets.toml
# 2. Replace CHANGE_ME_COACH_PASSWORD with your test password.
# 3. NEVER commit .streamlit/secrets.toml to Git!
# ==============================================================================

auth_password = "CHANGE_ME_COACH_PASSWORD"
environment = "production"
